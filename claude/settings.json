{
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(make help)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(kubectl get:*)",
      "Bash(kubectl describe:*)",
      "Bash(kubectl logs:*)",
      "Bash(kubectl config current-context)",
      "Bash(stern:*)",
      "Bash(terraform fmt:*)",
      "Bash(terraform validate:*)",
      "Bash(terraform plan:*)",
      "Bash(aws sts get-caller-identity:*)",
      "Bash(gcloud config list:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(kubectl apply:*)",
      "Bash(kubectl delete:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)"
    ],
    "deny": [
      "Read(~/.cache/op_env_cache)",
      "Read(./.env)",
      "Read(**/.env)",
      "Bash(op read:*)"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/secret-scan.sh"
          }
        ]
      }
    ]
  }
}
